# Neon API key (Console > Account settings > API keys). Used by 01 and 02.
NEON_API_KEY=
# Optional: the Neon organization to create the test project in.
NEON_ORG_ID=
# Supabase personal access token and an organization slug on the Free plan. Used by 03.
SUPABASE_ACCESS_TOKEN=
SUPABASE_ORG_SLUG=
SUPABASE_CA=local/supabase-prod-ca-2021.crt
